# =============================================================================
# Insurance Compliance System - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# --- LLM Provider Configuration ---
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# LLM Provider: "groq" (cloud, recommended) or "ollama" (local)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT=300

# --- Supabase Database ---
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-key-here

# --- Application Settings (Optional) ---
# ENVIRONMENT controls log output format:
#   development → human-readable text (default)
#   production/staging → structured JSON for log aggregation
ENVIRONMENT=development
# DEBUG=false
# SECRET_KEY=change-this-to-a-random-string-in-production
# LOG_LEVEL=INFO

# --- Security (Optional) ---
# Comma-separated API keys. Leave empty to disable authentication entirely.
# API_KEYS=key-one,key-two
RATE_LIMIT_MAX=100       # Max requests per minute per IP
RATE_LIMIT_WINDOW=60     # Rate limit window in seconds

# --- Redis (Optional, for caching & rate limiting) ---
# REDIS_URL=redis://localhost:6379/0
